<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Bot message aligned to left -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start">

        <!-- AI Avatar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="18dp"
            android:outlineAmbientShadowColor="@color/brand_primary"
            app:cardElevation="2dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:contentDescription="AI Assistant"
                android:scaleType="centerCrop"
                android:layout_marginTop="4dp"
                android:scaleX="4"
                android:scaleY="4"
                android:src="@drawable/ai_logo" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="@color/bot_message_bg"
            app:cardElevation="1dp">

            <TextView
                android:id="@+id/textViewBotMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="280dp"
                android:minHeight="36dp"
                android:gravity="start"
                android:padding="12dp"
                android:textColor="@color/bot_message_text"
                android:textSize="16sp"
                android:text="Bot message" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Timestamp -->
    <TextView
        android:id="@+id/textViewTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="2dp"
        android:layout_marginStart="44dp"
        android:textSize="12sp"
        android:textColor="@color/textColorTertiary"
        android:text="12:30 PM" />

</LinearLayout>